generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url  =env("DATABASE_URL")
}

model Admin{
  id String @id
  username String @unique
}
model Studens{
    id String @id
  username String @unique
  student
}
model Teacher{}
model Parent{}
model Grade{}
model Class{}
model Subject{}
model Lesson{}
model Exam{}
model Assignment{}
model Event{}
model AnnounceMent{}
